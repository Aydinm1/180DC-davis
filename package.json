{
  "name": "gap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.4"
    }
  },
  "scripts": {
    "predev": "node scripts/prepare-pdf-assets.mjs",
    "prebuild": "node scripts/prepare-pdf-assets.mjs",
    "pretest": "node scripts/prepare-pdf-assets.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test",
    "test:enrollment": "node --test scripts/verify-enrollment.mjs",
    "test:program": "node --test scripts/verify-program.mjs",
    "test:interaction": "node --test scripts/verify-interaction-styles.mjs",
    "test:db-types": "node scripts/check-db-types.mjs",
    "db:start": "node --env-file=.env.local scripts/start-supabase.mjs",
    "db:seed:demo": "docker exec -i supabase_db_gap psql -v ON_ERROR_STOP=1 --single-transaction -U postgres -d postgres < supabase/seed.sql",
    "db:clean:demo": "node scripts/clean-demo.mjs",
    "db:clean:uploads": "node scripts/cleanup-uploads.mjs",
    "test:storage": "node --experimental-strip-types --test scripts/verify-storage.mjs",
    "test:briefs": "node --experimental-strip-types --test scripts/verify-briefs.mjs",
    "test:assignments": "node --experimental-strip-types --test scripts/verify-multiple-assignments.mjs",
    "test:written": "node --experimental-strip-types --test scripts/verify-written-submissions.mjs",
    "test:monday-attendance": "node --test scripts/verify-monday-attendance.mjs",
    "test:attendance": "node --experimental-strip-types --test scripts/verify-attendance.mjs",
    "test:viewers": "node --experimental-strip-types --test scripts/verify-viewers.mjs",
    "test:test-participants": "node --experimental-strip-types --test scripts/verify-test-participants.mjs",
    "test:week-activity": "node --experimental-strip-types --test scripts/verify-week-activity.mjs",
    "test:grading": "node --experimental-strip-types --test scripts/verify-grading.mjs",
    "test:pdf": "node --test scripts/verify-pdf-reader.mjs",
    "test:security-schema": "node --test scripts/verify-security-schema.mjs",
    "test:teams": "node --experimental-strip-types --test scripts/verify-teams.mjs",
    "test:team-briefs": "node --experimental-strip-types --test scripts/verify-team-briefs.mjs",
    "test:completion": "node --experimental-strip-types --test scripts/verify-completion.mjs",
    "test:guided": "node --experimental-strip-types --test scripts/verify-guided.mjs",
    "test:cases": "node --experimental-strip-types --test scripts/verify-cases.mjs",
    "test:schedules": "node --experimental-strip-types --test scripts/verify-schedules.mjs",
    "test:investigations": "node --experimental-strip-types --test scripts/verify-investigations.mjs",
    "db:clean:examples": "node scripts/cleanup-grading-examples.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "fast-xml-parser": "^5.11.1",
    "next": "16.4.2",
    "pdfjs-dist": "6.5.438",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "tus-js-client": "^4.3.1",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/yauzl": "^3.4.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "playwright-core": "^1.63.0",
    "postcss": "8.5.26",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
